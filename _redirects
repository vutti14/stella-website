# Clean URLs — Netlify rewrite /about → /about.html (200).
# GitHub Pages already serves about.html at /about (no trailing slash).
# Relative links in the HTML (href="about", not href="/about") work on both.
/thank-you       /thank-you.html  200
/about           /about.html      200
/system          /system.html     200
/tiers           /tiers.html      200
/process         /process.html    200
/projects        /projects.html   200
/contact         /contact.html    200
/showroom        /showroom.html   200

# Custom 404 (Netlify). GitHub Pages serves 404.html automatically.
/*               /404.html        404

# Force HTTPS redirect (Netlify handles this automatically but explicit is better)
http://stella.co.th/*    https://stella.co.th/:splat    301!
http://www.stella.co.th/* https://stella.co.th/:splat    301!
https://www.stella.co.th/* https://stella.co.th/:splat   301!
